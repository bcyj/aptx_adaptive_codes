# EditorConfig configuration for LHDC codebase
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C / C++ / Headers (matching .clang-format)
[*.{c,h,cpp,hpp,cc,cxx}]
indent_style = space
indent_size = 4

# CMake build definitions
[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

# Python scripts
[*.py]
indent_style = space
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4
end_of_line = lf

# Windows Command / PowerShell scripts
[*.{bat,cmd,ps1}]
indent_style = space
indent_size = 4

# Data & Configuration files
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown documentation (preserve trailing spaces for line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Visual Studio projects & MSBuild XML
[*.{sln,vcxproj,vcxproj.filters,props,targets,xml}]
indent_style = space
indent_size = 2
end_of_line = crlf

# Makefiles & Android NDK build files (require tabs)
[{Makefile,*.mk,Android.mk,Application.mk}]
indent_style = tab
indent_size = 8
