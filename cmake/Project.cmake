set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
if(MSVC)
    add_compile_options(/utf-8)
endif()
set(APTX_AA_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")

# Match the LHDC superproject's component/resource selections when aptX is
# added below it, while retaining standalone defaults.
set(_APTX_AA_ENCODER_DEFAULT ON)
set(_APTX_AA_DECODER_DEFAULT ON)
set(_APTX_AA_BUNDLE_DEFAULT ON)
set(_APTX_AA_TESTS_DEFAULT OFF)
set(_APTX_AA_DRIVER_DEFAULT OFF)
set(_APTX_AA_EXTERNAL_ALLOCATOR_DEFAULT OFF)
if(DEFINED LHDC_BUILD_ENCODER)
    set(_APTX_AA_ENCODER_DEFAULT ${LHDC_BUILD_ENCODER})
endif()
if(DEFINED LHDC_BUILD_DECODER)
    set(_APTX_AA_DECODER_DEFAULT ${LHDC_BUILD_DECODER})
endif()
if(DEFINED LHDC_BUILD_BUNDLE)
    set(_APTX_AA_BUNDLE_DEFAULT ${LHDC_BUILD_BUNDLE})
endif()
if(DEFINED LHDC_BUILD_TESTS)
    set(_APTX_AA_TESTS_DEFAULT ${LHDC_BUILD_TESTS})
elseif(DEFINED BUILD_TESTING)
    set(_APTX_AA_TESTS_DEFAULT ${BUILD_TESTING})
endif()
if(DEFINED LHDC_DRIVER_RESOURCES)
    set(_APTX_AA_DRIVER_DEFAULT ${LHDC_DRIVER_RESOURCES})
endif()
if(DEFINED LHDC_EXTERNAL_ALLOCATOR_ONLY)
    set(_APTX_AA_EXTERNAL_ALLOCATOR_DEFAULT ${LHDC_EXTERNAL_ALLOCATOR_ONLY})
endif()
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    set(_APTX_AA_TOOLS_DEFAULT ON)
else()
    set(_APTX_AA_TOOLS_DEFAULT OFF)
endif()

option(BUILD_SHARED_LIBS "Build the combined shared library" OFF)
option(APTX_AA_BUILD_ENCODER "Build the aptX Adaptive encoder component" ${_APTX_AA_ENCODER_DEFAULT})
option(APTX_AA_BUILD_DECODER "Build the aptX Adaptive decoder component" ${_APTX_AA_DECODER_DEFAULT})
option(APTX_AA_BUILD_BUNDLE "Build the combined aptx_aa library from selected components" ${_APTX_AA_BUNDLE_DEFAULT})
option(APTX_AA_BUILD_TOOLS "Build hosted encoder/decoder command-line tools" ${_APTX_AA_TOOLS_DEFAULT})
option(APTX_AA_BUILD_TESTS "Build codec and numeric contract tests" ${_APTX_AA_TESTS_DEFAULT})
option(APTX_AA_SANITIZE "Enable address/undefined behavior sanitizers (GCC/Clang)" OFF)
option(APTX_AA_DRIVER_RESOURCES "Bounded stack/workspaces for a nonpaged SYS host" ${_APTX_AA_DRIVER_DEFAULT})
option(APTX_AA_DECODER_FIXED_POINT "Use integer Q29/64-bit decoder synthesis" ON)
option(APTX_AA_NO_CRT "Freestanding codec with explicit host allocation and shared audio modules" ${APTX_AA_DRIVER_RESOURCES})
if(APTX_AA_NO_CRT)
    set(_APTX_AA_EXTERNAL_ALLOCATOR_DEFAULT ON)
endif()
option(APTX_AA_EXTERNAL_ALLOCATOR_ONLY "Disable the default CRT heap; require a host allocator or workspace" ${_APTX_AA_EXTERNAL_ALLOCATOR_DEFAULT})
set(AUDIO_COMMON_ROOT "${APTX_AA_ROOT}/../audio_codec_common" CACHE PATH
    "Shared audio_codec_common source root")
if(APTX_AA_DRIVER_RESOURCES)
    if(NOT APTX_AA_NO_CRT OR NOT APTX_AA_EXTERNAL_ALLOCATOR_ONLY OR
       NOT APTX_AA_DECODER_FIXED_POINT OR APTX_AA_SANITIZE)
        message(FATAL_ERROR "Driver resources require NO_CRT ON, EXTERNAL_ALLOCATOR_ONLY ON, FIXED_POINT ON, SANITIZE OFF. Use a fresh build directory or set all options explicitly.")
    endif()
    if(NOT CMAKE_CONFIGURATION_TYPES)
        if(NOT CMAKE_BUILD_TYPE)
            set(CMAKE_BUILD_TYPE Release CACHE STRING "Driver profile requires Release" FORCE)
        elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
            message(FATAL_ERROR "Driver resources require Release/NDEBUG")
        endif()
    endif()
endif()
if(APTX_AA_NO_CRT AND NOT APTX_AA_EXTERNAL_ALLOCATOR_ONLY)
    message(FATAL_ERROR "NO_CRT requires EXTERNAL_ALLOCATOR_ONLY ON")
endif()
if(APTX_AA_SANITIZE AND NOT APTX_AA_BUILD_BUNDLE)
    message(FATAL_ERROR "SANITIZE requires BUILD_BUNDLE ON")
endif()
if(NOT TARGET audio_common::core)
    if(NOT EXISTS "${AUDIO_COMMON_ROOT}/CMakeLists.txt" OR
       NOT EXISTS "${AUDIO_COMMON_ROOT}/math/include/audio_math/integer.h" OR
       NOT EXISTS "${AUDIO_COMMON_ROOT}/core/include/audio_common/ring_buffer.h" OR
       NOT EXISTS "${AUDIO_COMMON_ROOT}/core/include/audio_common/memory.h")
        message(FATAL_ERROR "Set AUDIO_COMMON_ROOT to the audio_codec_common source tree")
    endif()
    if(NOT DEFINED AUDIO_COMMON_NO_CRT)
        set(AUDIO_COMMON_NO_CRT ${APTX_AA_NO_CRT} CACHE BOOL
            "Build common components for a freestanding host")
    endif()
    if(NOT DEFINED AUDIO_COMMON_DRIVER_RESOURCES)
        set(AUDIO_COMMON_DRIVER_RESOURCES ${APTX_AA_DRIVER_RESOURCES} CACHE BOOL
            "Use bounded stack/resource checks in common components")
    endif()
    add_subdirectory("${AUDIO_COMMON_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/audio_codec_common"
        EXCLUDE_FROM_ALL)
endif()
if(NOT TARGET audio_common::math_headers)
    message(FATAL_ERROR "audio_codec_common does not provide audio_common::math_headers")
endif()
if(APTX_AA_NO_CRT)
    if(APTX_AA_SANITIZE)
        message(FATAL_ERROR "NO_CRT cannot link sanitizer runtime")
    endif()
endif()
function(aptx_aa_objects target)
    target_compile_features(${target} PRIVATE c_std_11)
    target_compile_definitions(${target} PRIVATE
        APTX_AA_NO_CRT=$<BOOL:${APTX_AA_NO_CRT}>
        APTX_AA_DRIVER_RESOURCES=$<BOOL:${APTX_AA_DRIVER_RESOURCES}>
        APTX_AA_EXTERNAL_ALLOCATOR_ONLY=$<BOOL:${APTX_AA_EXTERNAL_ALLOCATOR_ONLY}>)
    target_link_libraries(${target} PRIVATE audio_common::core audio_common::math_headers)
    if(APTX_AA_NO_CRT)
        target_compile_definitions(${target} PRIVATE AUDIO_MATH_NO_CRT=1)
        if(MSVC)
            target_compile_options(${target} PRIVATE /O2 /GS- /Zl /Oi /utf-8)
        else()
            target_compile_options(${target} PRIVATE -O2 -fno-stack-protector)
            if(ANDROID)
                # Fortified libc wrappers cannot participate in a standalone codec.
                target_compile_options(${target} PRIVATE -U_FORTIFY_SOURCE)
            endif()
        endif()
    endif()
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_include_directories(${target} PRIVATE
        "${APTX_AA_ROOT}/aptx/common/include" "${APTX_AA_ROOT}/aptx/common/src/include")
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
        if(APTX_AA_DRIVER_RESOURCES)
            target_compile_options(${target} PRIVATE -fstack-usage -Werror=frame-larger-than=512)
        endif()
    endif()
    if(APTX_AA_SANITIZE AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    endif()
endfunction()
add_subdirectory(aptx/common)
if(APTX_AA_BUILD_ENCODER)
    add_subdirectory(aptx/encoder)
endif()
if(APTX_AA_BUILD_DECODER)
    add_subdirectory(aptx/decoder)
endif()

set(_APTX_AA_BUNDLE_OBJECTS $<TARGET_OBJECTS:aptx_aa_common_objects>)
if(APTX_AA_BUILD_ENCODER)
    list(APPEND _APTX_AA_BUNDLE_OBJECTS $<TARGET_OBJECTS:aptx_aa_encoder_objects>)
endif()
if(APTX_AA_BUILD_DECODER)
    list(APPEND _APTX_AA_BUNDLE_OBJECTS $<TARGET_OBJECTS:aptx_aa_decoder_objects>)
endif()
if(APTX_AA_BUILD_BUNDLE)
    add_library(aptx_aa ${_APTX_AA_BUNDLE_OBJECTS})
    add_library(aptx_aa::codec ALIAS aptx_aa)
    target_include_directories(aptx_aa PUBLIC
        $<BUILD_INTERFACE:${APTX_AA_ROOT}/include>
        $<BUILD_INTERFACE:${APTX_AA_ROOT}/aptx/common/include>
        $<BUILD_INTERFACE:${APTX_AA_ROOT}/aptx/encoder/include>
        $<BUILD_INTERFACE:${APTX_AA_ROOT}/aptx/decoder/include>
        $<INSTALL_INTERFACE:include>)
    target_compile_definitions(aptx_aa PUBLIC
        APTX_AA_DECODER_FIXED_POINT=$<BOOL:${APTX_AA_DECODER_FIXED_POINT}>
        APTX_AA_NO_CRT=$<BOOL:${APTX_AA_NO_CRT}>
        APTX_AA_DRIVER_RESOURCES=$<BOOL:${APTX_AA_DRIVER_RESOURCES}>
        APTX_AA_EXTERNAL_ALLOCATOR_ONLY=$<BOOL:${APTX_AA_EXTERNAL_ALLOCATOR_ONLY}>)
    target_link_libraries(aptx_aa PUBLIC audio_common::core PRIVATE audio_common::math_headers)
    set_target_properties(aptx_aa PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
    if(APTX_AA_NO_CRT AND BUILD_SHARED_LIBS)
        if(MSVC)
            # Keep codec sources on standard memory calls. For the standalone
            # validation DLL, pull the compiler's optimized local primitives;
            # static SYS component targets leave resolution to the WDK link.
            target_link_libraries(aptx_aa PRIVATE libvcruntime libcmt)
            target_link_options(aptx_aa PRIVATE /NODEFAULTLIB /NOENTRY)
        endif()
    endif()
endif()

if(APTX_AA_BUILD_TOOLS AND APTX_AA_BUILD_ENCODER)
    add_executable(aptx_aa_encode tools/cli/aptx_aa_encode.c)
    target_link_libraries(aptx_aa_encode PRIVATE aptx_aa::encoder audio_common::math_headers)
    if(BUILD_SHARED_LIBS AND APTX_AA_BUILD_BUNDLE)
        add_executable(aptx_aa_encode_shared tools/cli/aptx_aa_encode.c)
        target_link_libraries(aptx_aa_encode_shared PRIVATE aptx_aa::codec audio_common::math_headers)
    endif()
endif()
if(APTX_AA_BUILD_TOOLS AND APTX_AA_BUILD_DECODER)
    add_executable(aptx_aa_decode tools/cli/aptx_aa_decode.c)
    target_link_libraries(aptx_aa_decode PRIVATE aptx_aa::decoder audio_common::math_headers)
    if(BUILD_SHARED_LIBS AND APTX_AA_BUILD_BUNDLE)
        add_executable(aptx_aa_decode_shared tools/cli/aptx_aa_decode.c)
        target_link_libraries(aptx_aa_decode_shared PRIVATE aptx_aa::codec audio_common::math_headers)
    endif()
endif()
if(APTX_AA_SANITIZE AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    foreach(target aptx_aa aptx_aa_encode aptx_aa_decode aptx_aa_encode_shared aptx_aa_decode_shared)
        if(TARGET ${target})
            target_link_options(${target} PRIVATE -fsanitize=address,undefined)
        endif()
    endforeach()
endif()
if(APTX_AA_BUILD_TESTS)
    enable_testing()
    if(APTX_AA_BUILD_DECODER)
        add_executable(aptx_aa_decoder_safety aptx/decoder/tests/decoder_safety.c)
        target_link_libraries(aptx_aa_decoder_safety PRIVATE aptx_aa::decoder)
        if(APTX_AA_SANITIZE AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
            target_compile_options(aptx_aa_decoder_safety PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
            target_link_options(aptx_aa_decoder_safety PRIVATE -fsanitize=address,undefined)
        endif()
        add_test(NAME decoder_safety COMMAND aptx_aa_decoder_safety)
    endif()
    find_package(Python3 COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        set(_APTX_AA_VECTOR_MANIFEST "${APTX_AA_ROOT}/tests/vectors/parity/runs.txt")
        if(APTX_AA_BUILD_TOOLS AND APTX_AA_BUILD_ENCODER AND
           EXISTS "${_APTX_AA_VECTOR_MANIFEST}")
            add_test(NAME cli_vectors COMMAND ${Python3_EXECUTABLE}
                ${APTX_AA_ROOT}/aptx/encoder/tests/validate_cli.py $<TARGET_FILE:aptx_aa_encode>)
        endif()
        if(APTX_AA_BUILD_TOOLS AND APTX_AA_BUILD_DECODER AND
           EXISTS "${_APTX_AA_VECTOR_MANIFEST}")
            add_test(NAME decoder_cli COMMAND ${Python3_EXECUTABLE}
                ${APTX_AA_ROOT}/aptx/decoder/tests/validate_decoder_cli.py $<TARGET_FILE:aptx_aa_decode>)
        endif()
        if(APTX_AA_BUILD_TOOLS AND APTX_AA_BUILD_DECODER AND NOT APTX_AA_DECODER_FIXED_POINT AND
           EXISTS "${APTX_AA_ROOT}/tests/integration/validate_layout.py")
            add_test(NAME layout_pcm_regression COMMAND ${Python3_EXECUTABLE}
                ${APTX_AA_ROOT}/tests/integration/validate_layout.py $<TARGET_FILE:aptx_aa_decode>)
        endif()
        # ctypes must match the target pointer width; CLI tests still cover Win32
        # when the configured host interpreter is 64-bit. Android runs via adb.
        execute_process(COMMAND ${Python3_EXECUTABLE} -c "import struct; print(struct.calcsize('P'))"
            OUTPUT_VARIABLE APTX_AA_PYTHON_POINTER_SIZE OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(APTX_AA_BUILD_BUNDLE AND BUILD_SHARED_LIBS AND NOT CMAKE_CROSSCOMPILING AND
           APTX_AA_PYTHON_POINTER_SIZE EQUAL CMAKE_SIZEOF_VOID_P)
            if(APTX_AA_BUILD_ENCODER AND EXISTS "${_APTX_AA_VECTOR_MANIFEST}")
                add_test(NAME codec_vectors COMMAND ${Python3_EXECUTABLE}
                    ${APTX_AA_ROOT}/aptx/encoder/tests/validate_vectors.py $<TARGET_FILE:aptx_aa>)
                add_test(NAME stream_vectors COMMAND ${Python3_EXECUTABLE}
                    ${APTX_AA_ROOT}/aptx/encoder/tests/validate_stream.py $<TARGET_FILE:aptx_aa>)
            endif()
            if(APTX_AA_BUILD_DECODER AND NOT APTX_AA_DRIVER_RESOURCES AND
               EXISTS "${_APTX_AA_VECTOR_MANIFEST}")
                add_test(NAME decoder_vectors COMMAND ${Python3_EXECUTABLE}
                    ${APTX_AA_ROOT}/aptx/decoder/tests/validate_decoder.py $<TARGET_FILE:aptx_aa>)
            endif()
            if(APTX_AA_BUILD_DECODER AND APTX_AA_DECODER_FIXED_POINT AND
               EXISTS "${_APTX_AA_VECTOR_MANIFEST}")
                add_test(NAME fixed_synthesis COMMAND ${Python3_EXECUTABLE}
                    ${APTX_AA_ROOT}/aptx/decoder/tests/validate_fixed.py $<TARGET_FILE:aptx_aa>)
            endif()
        endif()
    endif()
endif()
set(_APTX_AA_INSTALL_TARGETS aptx_aa_common)
foreach(target aptx_aa aptx_aa_encoder aptx_aa_decoder aptx_aa_encode aptx_aa_decode)
    if(TARGET ${target})
        list(APPEND _APTX_AA_INSTALL_TARGETS ${target})
    endif()
endforeach()
install(TARGETS ${_APTX_AA_INSTALL_TARGETS}
    RUNTIME DESTINATION bin LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
install(FILES include/aptx_aa.h DESTINATION include)
foreach(part common encoder decoder)
    install(DIRECTORY aptx/${part}/include/ DESTINATION include)
endforeach()
